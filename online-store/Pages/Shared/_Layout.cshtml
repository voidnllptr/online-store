<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Интернет-магазин</title>
    <link rel="icon" href="~/images/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/online-store.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary d-none d-lg-block">
            <div class="container">
                <div class="d-flex justify-content-between w-100">
                    <div class="d-flex">
                        <a class="navbar-brand me-4" asp-page="/Index">Интернет-магазин</a>
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalog/Index">Каталог</a>
                            </li>
                        </ul>
                    </div>
                    <div class="d-flex">
                        <form class="search-form d-flex" method="get" action="/Catalog/Index">
                            <div class="input-group me-3" style="width: 300px;">
                                <input type="text" class="form-control search-input" name="search" placeholder="Поиск товаров..." value="@Context.Request.Query["search"]">
                                <button class="btn btn-light search-button" type="submit">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Cart/Index">
                                    <i class="bi bi-cart3" style="font-size: 1.25rem;"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        0
                                    </span>
                                </a>
                            </li>
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <nav class="navbar fixed-bottom d-lg-none d-block navbar-dark bg-primary">
            <div class="container-fluid">
                <div class="d-flex justify-content-around w-100">
                    <a class="nav-link text-white text-center" asp-page="/Index">
                        <i class="bi bi-house-door d-block" style="font-size: 1.5rem;"></i>
                        <small>Главная</small>
                    </a>
                    <a class="nav-link text-white text-center" asp-page="/Catalog/Index">
                        <i class="bi bi-grid d-block" style="font-size: 1.5rem;"></i>
                        <small>Каталог</small>
                    </a>
                    <a class="nav-link text-white text-center" asp-page="/Cart/Index">
                        <div class="position-relative d-inline-block">
                            <i class="bi bi-cart3 d-block" style="font-size: 1.5rem;"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                0
                            </span>
                        </div>
                        <small>Корзина</small>
                    </a>
                    <a class="nav-link text-white text-center" href="#account-menu" data-bs-toggle="modal">
                        <i class="bi bi-person d-block" style="font-size: 1.5rem;"></i>
                        <small>Профиль</small>
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Интернет-магазин - <a asp-page="/Privacy">Конфиденциальность</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>