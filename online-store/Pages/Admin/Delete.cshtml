@page "{id:int}"
@model online_store.Pages.Admin.DeleteModel

<h1>Удалить товар</h1>

<h3>Вы уверены, что хотите удалить этот товар?</h3>

<div>
    <h4>@Model.Product.Name</h4>
    <dl class="row">
        <dt class="col-sm-2">Категория</dt>
        <dd class="col-sm-10">@Model.Product.Category?.Name</dd>

        <dt class="col-sm-2">Цена</dt>
        <dd class="col-sm-10">@Model.Product.Price</dd>

        <dt class="col-sm-2">Остаток</dt>
        <dd class="col-sm-10">@Model.Product.Stock</dd>
    </dl>
</div>

<form method="post">
    <input type="hidden" asp-for="Product.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Отмена</a>
</form>
